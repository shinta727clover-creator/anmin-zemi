---
import Base from '../../layouts/Base.astro';
import SocialLinks from '../../components/SocialLinks.astro';import {publishedComics,comicUrl} from '../../lib/comics';
export async function getStaticPaths(){const comics=await publishedComics();return comics.map((comic,index)=>({params:{number:String(comic.data.number).padStart(3,'0')},props:{comic,previous:comics[index+1]??null,next:comics[index-1]??null}}))}
const {comic,previous,next}=Astro.props;const url=new URL(Astro.url.pathname,Astro.site).toString();const share=encodeURIComponent(url);const title=`第${comic.data.number}話「${comic.data.title}」｜安眠ゼミ`;const jsonLd={ '@context':'https://schema.org','@type':'ComicStory',headline:comic.data.title,description:comic.data.description,datePublished:comic.data.date.toISOString(),url,image:comic.data.images.map((p:string)=>new URL(p,Astro.site).toString())};
---
<Base title={title} description={comic.data.description} image={comic.data.ogImage||comic.data.images[0]||'/assets/og-default.svg'}><div class="reader"><nav aria-label="パンくず"><a href="/">ホーム</a> / <a href="/comic/">漫画一覧</a> / 第{comic.data.number}話</nav><h1>第{comic.data.number}話　{comic.data.title}</h1><p class="muted"><time datetime={comic.data.date.toISOString()}>{comic.data.date.toLocaleDateString('ja-JP')}</time></p>{comic.data.images.map((src:string,index:number)=><img src={src} alt={`第${comic.data.number}話「${comic.data.title}」漫画画像 ${index+1}/${comic.data.images.length}`} loading={index===0?'eager':'lazy'} decoding="async" width="800" height="1100"/>)}<div class="reader-nav">{previous?<a href={comicUrl(previous.data.number)}>← 前の話</a>:<span/>}{next?<a class="button" href={comicUrl(next.data.number)}>次の話 →</a>:<a class="button" href="/comic/">漫画一覧へ →</a>}</div><h2>この漫画をシェア</h2><p><a target="_blank" rel="noopener noreferrer" href={`https://twitter.com/intent/tweet?url=${share}&text=${encodeURIComponent(title)}`}>Xでシェア</a>　<a target="_blank" rel="noopener noreferrer" href={`https://social-plugins.line.me/lineit/share?url=${share}`}>LINEでシェア</a></p><p><a href="/comic/">漫画一覧へ戻る</a></p><section class="reader-social" aria-labelledby="reader-social-heading"><h2 id="reader-social-heading">安眠ゼミをSNSでもフォロー ☾</h2><p>新しいお話のお知らせはこちらから。</p><SocialLinks ariaLabel="安眠ゼミ公式InstagramとX" /></section><div class="reader-explore"><h2>夢見町をもっと楽しむ</h2><p><a href="/characters/">なかまたちに会う →</a>　<a href="/yumemicho/">夢見町を訪ねる →</a></p></div>{previous&&<aside class="reader-related"><h2>次におすすめのお話</h2><a href={comicUrl(previous.data.number)}>第{previous.data.number}話　{previous.data.title} →</a></aside>}</div><script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/></Base>
