---
import Base from '../../../layouts/Base.astro';
import { publishedComics, comicUrl } from '../../../lib/comics';

export async function getStaticPaths() {
  const comics = await publishedComics();
  const pageSize = 24;
  const pageCount = Math.ceil(comics.length / pageSize);
  const paths = [];

  for (let pageNumber = 2; pageNumber <= pageCount; pageNumber++) {
    const start = (pageNumber - 1) * pageSize;
    paths.push({
      params: { page: String(pageNumber) },
      props: {
        items: comics.slice(start, start + pageSize),
        total: pageCount,
      },
    });
  }
  return paths;
}

const { items, total } = Astro.props;
const page = Number(Astro.params.page);
const previousUrl = page === 2 ? '/comic/' : `/comic/page/${page - 1}/`;
const nextUrl = page < total ? `/comic/page/${page + 1}/` : null;
---
<Base title={`漫画一覧 ${page}ページ｜安眠ゼミ公式サイト`}>
  <div class="wrap page">
    <h1>漫画一覧・{page}ページ</h1>
    <div class="cards">
      {items.map((comic) => (
        <article class="card">
          <a href={comicUrl(comic.data.number)}>
            {comic.data.images[0] && (
              <img src={comic.data.images[0]} alt="" loading="lazy" width="600" height="450" />
            )}
            <p>第{comic.data.number}話</p>
            <h2>{comic.data.title}</h2>
          </a>
        </article>
      ))}
    </div>
    <nav class="reader-nav" aria-label="漫画一覧ページ">
      <a href={previousUrl}>← 前のページ</a>
      <span>{page}/{total}</span>
      {nextUrl && <a href={nextUrl}>次のページ →</a>}
    </nav>
  </div>
</Base>
